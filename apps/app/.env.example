# Copy to apps/app/.env for local dev (never commit .env).
# Toutes ces variables sont lues côté serveur Nitro uniquement (jamais exposées au client).

# Base de données (correspond au docker-compose.yml local).
DATABASE_URL=postgresql://cvo:cvo@localhost:5432/cvo?schema=public

# Better Auth — clé secrète (min 32 chars, changer en prod).
BETTER_AUTH_SECRET=dev-secret-change-in-prod-min32chars!!

# URL de base de l'app (utilisée pour générer les magic-links).
APP_URL=http://localhost:3000

# Claude (API Messages) — analyse d'offre, score de match et génération de CV
# (THI-124 / flux candidature). Sans cette clé, /api/candidature/* répond 502.
ANTHROPIC_API_KEY=sk-ant-changeme

# Dev uniquement : si "true", désactive le gate de crédits à la génération
# (le modèle crédits reste codé ; à ne PAS activer en prod).
# DISABLE_GENERATION_LIMIT=true

# Stripe — billing par packs de crédits (Checkout hébergé). Clés de TEST en dev.
# STRIPE_SECRET_KEY : clé restreinte (rk_test_…) recommandée, ou sk_test_…. JAMAIS committée.
# STRIPE_WEBHOOK_SECRET : donné par `stripe listen --forward-to localhost:3000/api/billing/webhook`.
# STRIPE_PUBLISHABLE_KEY : publique (pk_test_…) — NON requise pour Checkout hébergé
#   (réservée à un futur Payment Element embarqué).
STRIPE_SECRET_KEY=rk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
# STRIPE_PUBLISHABLE_KEY=pk_test_changeme

# SMTP (optionnel en dev — si absent, le magic-link est loggé dans la console).
# SMTP_HOST=smtp.example.fr
# SMTP_PORT=587
# SMTP_USER=no-reply@cv-optimizer.fr
# SMTP_PASS=changeme
# MAIL_FROM=no-reply@cv-optimizer.fr
